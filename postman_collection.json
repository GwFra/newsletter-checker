{
  "info": {
    "name": "Newsletter Checker",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "Feeds",
      "item": [
        {
          "name": "Get feeds",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/feeds"
          }
        },
        {
          "name": "Create / trigger feeds",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/feeds",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"example\",\n  \"name\": \"example\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create / trigger process",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/feeds/:id/process"
          }
        },
        {
          "name": "Create / trigger process",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/feeds/process"
          }
        }
      ]
    },
    {
      "name": "Articles",
      "item": [
        {
          "name": "Get articles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/articles?feedId=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "articles"
              ],
              "query": [
                {
                  "key": "feedId",
                  "value": "",
                  "description": "Filter by feedId"
                }
              ]
            }
          }
        },
        {
          "name": "Get summary by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/articles/summary/:id"
          }
        },
        {
          "name": "Get summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/articles/summary"
          }
        }
      ]
    },
    {
      "name": "Preferences",
      "item": [
        {
          "name": "Get preferences",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/preferences"
          }
        },
        {
          "name": "Create / trigger preferences",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/preferences",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferences\": [\n    \"example\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
